# Project Zia Configuration Template
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# Server Networking
ZIA_HOST=0.0.0.0
ZIA_PORT=5000

# 1. AI Companion Brain (google-genai)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
ZIA_AI_MODEL=gemini-2.5-flash

# 2. Telegram Bot Gateway (Optional, for remote control on the go)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to interact with the bot (leave empty to auto-pin your first chat)
TELEGRAM_ALLOWED_CHAT_IDS=

# 3. Voice Pipeline (edge-tts)
# Default voice: en-US-AvaNeural, en-US-EmmaNeural, en-US-BrianNeural, etc.
ZIA_VOICE=en-US-AvaNeural

